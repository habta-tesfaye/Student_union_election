import "./App.css";

import { useAuthContext } from "./context/AuthContext";
import DirectorDashboardPage from "./features/dashboard/pages/DirectorDashboardPage";
import AdminDashboardPage from "./features/dashboard/pages/AdminDashboardPage";
import RegistrarDashboardPage from "./features/dashboard/pages/RegistrarDashboardPage";
import ForgotPasswordPage from "./features/auth/pages/ForgotPasswordPage";
import LoginPage from "./features/auth/pages/LoginPage";

function App() {
  const { user, isAuthenticated, signOut } = useAuthContext();

  const currentPath = window.location.pathname;

  // Show the appropriate page when a user is signed in.
  // the existing backend dashboard endpoint is for the admin
  if (isAuthenticated && user) {
    if (user.role === "admin") {
  return <AdminDashboardPage />;
}
// the existanc of a registeral dasbored 
if (user.role === "registrar") {
  return <RegistrarDashboardPage />;
}
    // The existing backend dashboard endpoint is for the Director (SSD).
    if (user.role === "director") {
      return <DirectorDashboardPage />;
    }

    const displayName = [
      user.firstName,
      user.middleName,
      user.lastName,
    ]
      .filter(Boolean)
      .join(" ");

    const roleLabels: Record<string, string> = {
      student: "Student / Voter",
      admin: "System Administrator",
      registrar: "Registrar",
      director: "SSD",
      head: "Department Head",
    };

    return (
      <main className="app">
        <header className="app-header">
          <div className="app-brand">
            <div className="app-logo">DMU</div>

            <div className="app-brand-text">
              <h1>Debre Markos University</h1>
              <p>Bure Campus</p>
            </div>
          </div>

          <span className="app-system-label">
            Student Union Election System
          </span>
        </header>

        <section className="welcome-section">
          <div className="welcome-content">
            <span className="welcome-badge">
              {roleLabels[user.role] ?? user.role}
            </span>

            <h2>Welcome, {displayName || "User"}</h2>

            <p className="welcome-description">
              You have signed in successfully. This is your role-based
              starting page. We will connect the available system features
              here step by step.
            </p>

            <button
              className="welcome-login-link"
              type="button"
              onClick={signOut}
            >
              Sign out
            </button>
          </div>
        </section>

        <footer className="app-footer">
          <p>
            © {new Date().getFullYear()} Debre Markos University, Bure Campus.
            Student Union Election System.
          </p>
        </footer>
      </main>
    );
  }

  // Pages available when the user is not signed in.
  if (currentPath === "/login") {
    return <LoginPage />;
  }

  if (currentPath === "/forgot-password") {
    return <ForgotPasswordPage />;
  }

  // Public welcome page.
  return (
    <main className="app">
      <header className="app-header">
        <div className="app-brand">
          <div className="app-logo">DMU</div>

          <div className="app-brand-text">
            <h1>Debre Markos University</h1>
            <p>Bure Campus</p>
          </div>
        </div>

        <span className="app-system-label">
          Student Union Election System
        </span>
      </header>

      <section className="welcome-section">
        <div className="welcome-content">
          <span className="welcome-badge">Bure Campus</span>

          <h2>
            Student Union
            <br />
            Election System
          </h2>

          <p className="welcome-description">
            A centralized digital platform for managing student union
            elections, candidate nominations, voting, examinations, campaigns
            and election results.
          </p>

          <div className="welcome-status">
            <span className="status-indicator" />
            Frontend development started
          </div>

          <a className="welcome-login-link" href="/login">
            Sign in to the system
          </a>
        </div>

        <div className="welcome-information">
          <h3>Election Management Platform</h3>

          <p>
            The system supports the actors defined in the original system
            requirements:
          </p>

          <ul>
            <li>System Administrator</li>
            <li>Registrar</li>
            <li>Student / Voter</li>
            <li>SSD</li>
            <li>Candidate</li>
            <li>Department Head</li>
          </ul>
        </div>
      </section>

      <footer className="app-footer">
        <p>
          © {new Date().getFullYear()} Debre Markos University, Bure Campus.
          Student Union Election System.
        </p>
      </footer>
    </main>
  );
}

export default App;